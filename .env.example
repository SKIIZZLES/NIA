# NIA — variables d'environnement (copier vers .env)
# Ne jamais committer de secrets réels.

# Mode auth (mvp = mock local ; supabase = Auth réel)
EXPO_PUBLIC_AUTH_MODE=mvp

# Supabase (futur)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# CDN vidéo (futur)
EXPO_PUBLIC_VIDEO_CDN_BASE=

# EAS / analytics (optionnel)
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=
