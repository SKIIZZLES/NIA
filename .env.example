# NIA — variables d'environnement (copier vers .env)
# Ne jamais committer de secrets réels.

# Mode : si URL + ANON_KEY sont vides → mock offline automatique
# Expo Go : toujours mock (même si clés présentes)
# EAS preview/production : client Supabase réel si clés présentes

# Supabase — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (EAS natif — voir GOOGLE_AUTH.md)
# Client ID type « Web application » (requis pour idToken Android/iOS)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=PLACEHOLDER.apps.googleusercontent.com
# Client ID type « Android » (informational / docs ; SHA-1 lié dans Google Cloud)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=PLACEHOLDER.apps.googleusercontent.com
# Client ID type « iOS » (optionnel ; iosUrlScheme = reversed client id)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=PLACEHOLDER.apps.googleusercontent.com

# CDN vidéo (optionnel, futur)
EXPO_PUBLIC_VIDEO_CDN_BASE=

# EAS / analytics (optionnel)
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=

# Snapchat Login Kit (OAuth PKCE — voir SNAPCHAT_AUTH.md)
# Client ID public (portail kit.snapchat.com). Secret UNIQUEMENT en Edge Function.
EXPO_PUBLIC_SNAP_CLIENT_ID=PLACEHOLDER
# Optionnel : URL complète de la fonction (sinon {SUPABASE_URL}/functions/v1/snapchat-auth)
EXPO_PUBLIC_SNAPCHAT_AUTH_URL=
