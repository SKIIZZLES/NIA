{
  "expo": {
    "name": "NIA",
    "slug": "nia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nia.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "NIA utilise la caméra pour créer des vidéos.",
        "NSMicrophoneUsageDescription": "NIA utilise le micro pour enregistrer des vidéos.",
        "NSPhotoLibraryUsageDescription": "NIA accède à vos médias pour publier."
      }
    },
    "android": {
      "package": "app.nia.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NIA accède à vos médias pour publier."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0b25a3fe-2543-4804-a47b-6009a532304f"
      }
    },
    "owner": "nia-corp"
  }
}
