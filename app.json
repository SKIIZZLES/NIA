{
  "expo": {
    "name": "NIA",
    "slug": "nia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nia",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nia.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "NIA utilise la cam\u00e9ra pour cr\u00e9er des vid\u00e9os.",
        "NSMicrophoneUsageDescription": "NIA utilise le micro pour enregistrer des vid\u00e9os.",
        "NSPhotoLibraryUsageDescription": "NIA acc\u00e8de \u00e0 vos m\u00e9dias pour publier."
      }
    },
    "android": {
      "package": "app.nia.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NIA acc\u00e8de \u00e0 vos m\u00e9dias pour publier.",
          "cameraPermission": "NIA utilise la cam\u00e9ra pour filmer des vid\u00e9os.",
          "microphonePermission": "NIA utilise le micro pour enregistrer des vid\u00e9os."
        }
      ],
      "expo-video",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER_IOS_CLIENT_ID"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0b25a3fe-2543-4804-a47b-6009a532304f"
      }
    },
    "owner": "nia-corp"
  }
}
